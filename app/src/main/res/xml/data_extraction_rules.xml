<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="database" path="com.google.android.datatransport.events" />
        <exclude domain="database" path="com.google.android.datatransport.events-journal" />
        <exclude domain="root" path="cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="root" path="cache" />
    </device-transfer>
</data-extraction-rules>
